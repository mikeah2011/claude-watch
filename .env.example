# Claude Watch 配置示例
# 复制此文件为 .env 并填入你自己的配置
# 使用方式: source .env

# Apple Developer 配置
DEVELOPMENT_TEAM=YOUR_TEAM_ID
BUNDLE_ID_PREFIX=com.yourname.claudewatch

# 服务器配置（Bridge）
PORT=3000
HOST=0.0.0.0

# Claude API 配置（如需要）
# ANTHROPIC_API_KEY=sk-ant-xxx

# ── xcodegen 构建配置 ──
# 以下变量控制 ios/ClaudeWatch/project.yml 的生成
# 所有变量都有默认值，只需按需取消注释并修改

IOS_BUNDLE_SUFFIX=app
WATCH_BUNDLE_SUFFIX=watchkitapp
PRODUCT_NAME="Agent Watch"
SWIFT_VERSION=5.9
IOS_DEPLOYMENT_TARGET=17.0
WATCHOS_DEPLOYMENT_TARGET=10.0

# ── App 版本 ──
APP_VERSION=1.0
APP_BUILD=1

# ── 设备安装配置（make install） ──
IPHONE_ID=YOUR_IPHONE_UUID
WATCH_ID=YOUR_WATCH_UUID
